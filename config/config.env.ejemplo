#/etc/iptables-monitor/config.env.ejemplo

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-cuenta@gmail.com # el que envía el correo mediante smtp
SMTP_PASS=abcdefghijklmnop # contraseña de ejemplo, 16 caracteres sin espacios
EMAIL_FROM=tu-cuenta@gmail.com # generalmente el mismo que smtp_user
EMAIL_TO=tu-correo-personal_o_tu-cuenta@gmail.com
